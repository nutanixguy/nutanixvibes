---
type Props = {
  name: string;
  url: string;
  author?: string;
  language: string;
  focus: string;
};

const { name, url, author, language, focus } = Astro.props;
const showAuthor =
  author !== undefined && author.toLowerCase() !== name.toLowerCase();
---

<li class="border-border bg-muted flex h-full flex-col border p-4 sm:p-5">
  <div class="flex items-start justify-between gap-3">
    <h2 class="font-accent text-lg leading-snug font-semibold break-words">
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent underline decoration-dashed underline-offset-4"
      >
        {name}
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
    </h2>
    <p
      class="border-border text-muted-foreground font-accent shrink-0 border px-1.5 py-0.5 text-xs tracking-wide"
    >
      <span class="sr-only">Language: </span>
      {language}
    </p>
  </div>
  {showAuthor && <p class="text-muted-foreground mt-2 text-sm">{author}</p>}
  <p class="mt-3 text-sm leading-relaxed">{focus}</p>
</li>
