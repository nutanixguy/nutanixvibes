---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import {
  heroBannerAlt,
  heroBannerImage,
  jamieLogoAlt,
  jamieLogoImage,
} from "@/assets/site-images";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="my-1"
  >
    <section id="hero" class="border-border border-b pb-6">
      <div class="mx-auto w-full max-w-6xl px-4">
        <div class="border-border relative overflow-hidden rounded-sm border">
          <Image
            src={heroBannerImage}
            alt={heroBannerAlt}
            widths={[640, 960, 1280, 1920]}
            sizes="(min-width: 72rem) 70rem, calc(100vw - 2rem)"
            format="webp"
            quality={80}
            priority
            class="block h-auto w-full"
          />
          <div
            class="hero-copy px-4 py-4 sm:absolute sm:inset-y-0 sm:start-0 sm:flex sm:w-[44%] sm:items-center sm:px-6 sm:py-4"
          >
            <div>
              <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                <h1
                  class="font-accent text-3xl leading-none font-bold md:text-4xl lg:text-5xl"
                >
                  Nutanix Vibes
                </h1>
                <a
                  target="_blank"
                  href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
                  class="inline-block"
                  aria-label="RSS Feed"
                  title="RSS Feed"
                >
                  <IconRss
                    width={20}
                    height={20}
                    class="scale-125 stroke-white stroke-3 rtl:-rotate-90"
                  />
                  <span class="sr-only">RSS Feed</span>
                </a>
              </div>
              <p class="mt-2 text-sm md:text-base">{config.site.description}</p>
            </div>
          </div>
        </div>
      </div>

      <div class="app-layout pt-8">
        <div class="flex items-start gap-4">
          <Image
            src={jamieLogoImage}
            alt={jamieLogoAlt}
            width={288}
            format="webp"
            quality={85}
            loading="eager"
            class="border-border mt-1 h-auto w-24 shrink-0 rounded-sm border sm:w-32"
          />
          <div class="min-w-0">
            <p>
              I'm Jamie Terrell. These are field notes on Nutanix and Prism
              Central: the problems I wish I could have searched for. New here?{
                " "
              }
              <LinkButton
                class="hover:text-accent underline decoration-dashed underline-offset-4"
                href={getRelativeLocaleUrl(locale, "start-here")}
              >
                Start here
              </LinkButton>
              .
            </p>
            {
              socials.length > 0 && (
                <div class="mt-4 flex max-sm:flex-col sm:items-center">
                  <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
                    {t.home.socialLinks}:
                  </div>
                  <Socials />
                </div>
              )
            }
          </div>
        </div>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "app-layout pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="app-layout pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="app-layout my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  /*
    Mobile copy sits on a band under the banner. From 40rem up it overlays the
    empty left side of the art. #01061d is the bottom-left pixel of the q80
    1120px hero. White on it is 20.09:1. Theme text #131313 on it is 1.08:1,
    so this block does not use the theme foreground color.
  */
  .hero-copy {
    background-color: #01061d;
    color: #ffffff;
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.45);
  }

  @media (min-width: 40rem) {
    .hero-copy {
      background-color: transparent;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
