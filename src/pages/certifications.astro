---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const entries = (await getCollection("certifications")).sort((a, b) =>
  a.data.credentialId.localeCompare(b.data.credentialId)
);
---

<Layout
  title={`Certifications | ${config.site.title}`}
  description="Example certification cards. Every entry is fake and labeled EXAMPLE."
>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle="Certifications"
    pageDesc="Driven by the certifications content collection. Both entries are fake."
  >
    <p class="max-w-app mb-6">
      These cards come from YAML files in
      <code>src/content/certifications/</code>. Each file has
      <code>label: EXAMPLE</code>. They are layout samples, not a record of
      certifications Jamie holds. The about page mentions real credential names
      in passing. Those names are not loaded here.
    </p>

    {
      entries.length === 0 ? (
        <p>No certification entries found.</p>
      ) : (
        <ul class="grid gap-4">
          {entries.map(entry => (
            <li class="border-border bg-muted/70 border p-4">
              <p class="font-accent text-accent text-xs font-semibold tracking-wide uppercase">
                {entry.data.label}
              </p>
              <h2 class="font-accent mt-1 text-xl font-semibold">
                {entry.data.title}
              </h2>
              <p class="text-muted-foreground mt-1 text-sm">
                {entry.data.issuer}
              </p>
              <dl class="mt-3 space-y-1 text-sm">
                <div class="flex flex-wrap gap-x-2">
                  <dt class="font-medium">Credential id</dt>
                  <dd>
                    <code>{entry.data.credentialId}</code>
                  </dd>
                </div>
                <div class="flex flex-wrap gap-x-2">
                  <dt class="font-medium">Issued</dt>
                  <dd>{entry.data.issued}</dd>
                </div>
              </dl>
              <p class="mt-3">{entry.data.summary}</p>
            </li>
          ))}
        </ul>
      )
    }
  </Main>
  <Footer />
</Layout>
