---
import { getCollection, getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(about);
const certifications = (await getCollection("certifications")).sort((a, b) =>
  a.data.credentialId.localeCompare(b.data.credentialId)
);
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={about.data.title} class="app-prose">
    <Content />

    <section id="certifications" class="not-prose mt-12 scroll-mt-8">
      <h2 class="font-accent text-2xl font-semibold">Certifications</h2>
      <p class="mt-2 mb-6">
        These cards come from YAML files in{" "}
        <code>src/content/certifications/</code>. Each file has{" "}
        <code>label: EXAMPLE</code>. They are layout samples, not a record of
        certifications Jamie holds. The paragraph above names real credentials
        in prose. Those names are not loaded here.
      </p>
      {
        certifications.length === 0 ? (
          <p>No certification entries found.</p>
        ) : (
          <ul class="grid gap-4">
            {certifications.map(entry => (
              <li class="border-border bg-muted/70 border p-4">
                <p class="font-accent text-accent text-xs font-semibold tracking-wide uppercase">
                  {entry.data.label}
                </p>
                <h3 class="font-accent mt-1 text-xl font-semibold">
                  {entry.data.title}
                </h3>
                <p class="text-muted-foreground mt-1 text-sm">
                  {entry.data.issuer}
                </p>
                <dl class="mt-3 space-y-1 text-sm">
                  <div class="flex flex-wrap gap-x-2">
                    <dt class="font-medium">Credential id</dt>
                    <dd>
                      <code>{entry.data.credentialId}</code>
                    </dd>
                  </div>
                  <div class="flex flex-wrap gap-x-2">
                    <dt class="font-medium">Issued</dt>
                    <dd>{entry.data.issued}</dd>
                  </div>
                </dl>
                <p class="mt-3">{entry.data.summary}</p>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </Main>

  <Footer />
</Layout>
